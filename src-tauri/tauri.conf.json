{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliMaku",
  "version": "1.0.1",
  "identifier": "wjz.bilimaku.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "BiliMaku｜哔哩弹幕姬",
        "width": 690,
        "height": 460,
        "minWidth": 690,
        "minHeight": 460,
        "center": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "micaLight"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
